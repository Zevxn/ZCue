<Application x:Class="ZCue.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:infrastructure="clr-namespace:ZCue.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- SECTION Fluent 控件与兼容样式 -->
            <Style x:Key="SelectionContextMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <ContextMenu x:Key="DefaultControlContextMenu">
                <MenuItem Header="复制" Command="{x:Static ApplicationCommands.Copy}" InputGestureText="Ctrl+C"
                          Style="{StaticResource SelectionContextMenuItem}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                <MenuItem Header="剪切" Command="{x:Static ApplicationCommands.Cut}" InputGestureText="Ctrl+X"
                          Style="{StaticResource SelectionContextMenuItem}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                <MenuItem Header="粘贴" Command="{x:Static ApplicationCommands.Paste}" InputGestureText="Ctrl+V"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlacementTarget.IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </ContextMenu>
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            </Style>
            <Style x:Key="FluentPrimaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="Appearance" Value="Primary" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="infrastructure:ButtonPressFeedbackService.IsEnabled" Value="False" />
            </Style>
            <Style x:Key="FluentSecondaryButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FluentPrimaryButton}">
                <Setter Property="Appearance" Value="Secondary" />
            </Style>
            <Style x:Key="FluentToggleSwitch" TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="OnContent" Value="{x:Null}" />
                <Setter Property="OffContent" Value="{x:Null}" />
            </Style>
            <Style x:Key="FluentSettingCard" TargetType="{x:Type ui:Card}" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="FieldComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="infrastructure:ComboBoxPopupSpacing.Gap" Value="6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsEditable" Value="False">
                        <Setter Property="ContextMenu" Value="{x:Null}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ThemeComboBoxItem" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="RoundedTextBoxBase" TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ThemedCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <!-- !SECTION Fluent 控件与兼容样式 -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
