<Window x:Class="ZCue.Views.PromptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑指令"
        Icon="pack://application:,,,/assets/logo.png"
        Width="620"
        Height="640"
        MinWidth="560"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Cursor="{TemplateBinding Cursor}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Cursor="{TemplateBinding Cursor}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxBase}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="3,8,10,8" />
        </Style>
        <Style x:Key="PromptEditorCategoryComboBoxItem"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource ThemeComboBoxItem}">
            <Setter Property="Height" Value="40" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock x:Name="TitleTextBlock"
                       Text="新建指令"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Margin="0,7,0,0"
                       Text="设置名称和要插入到当前输入框的完整内容。"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                       FontSize="13" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="指令名称"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeTextStrongBrush}" />
            <TextBox x:Name="NameTextBox"
                     Grid.Row="1"
                     Margin="0,7,0,14"
                     Height="40"
                     Padding="3,4,10,4"
                     VerticalContentAlignment="Center"
                     Style="{StaticResource FieldTextBox}"
                     MaxLength="80" />

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,6"
                       Text="指令分类"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeTextStrongBrush}" />
            <ComboBox x:Name="CategoryComboBox"
                      Grid.Row="3"
                      Margin="0,0,0,14"
                      HorizontalAlignment="Stretch"
                      Height="40"
                      FontSize="14"
                      MaxDropDownHeight="320"
                      Style="{StaticResource FieldComboBox}"
                      ItemContainerStyle="{StaticResource PromptEditorCategoryComboBoxItem}"
                      SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="4"
                       Margin="0,0,0,6"
                       Text="指令内容"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeTextStrongBrush}" />
            <TextBox x:Name="ContentTextBox"
                     Grid.Row="5"
                     Style="{StaticResource FieldTextBox}"
                     MinHeight="150"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     MaxLength="10000" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="EnabledCheckBox"
                      Style="{StaticResource ThemedCheckBox}"
                      Grid.Column="0"
                      Content="启用这条指令"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Foreground="{DynamicResource ThemeTextStrongBrush}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Click="HandleCancelClick" />
                <Button Content="保存"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="HandleSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
