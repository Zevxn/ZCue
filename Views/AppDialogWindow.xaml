<Window x:Class="ZCue.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZCue"
        Width="500"
        MinHeight="210"
        MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        KeyDown="HandleWindowKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Cursor="{TemplateBinding Cursor}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogSecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogDangerButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDangerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Cursor="{TemplateBinding Cursor}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface"
                                        Property="Background"
                                        Value="{DynamicResource ThemeHoverSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="{DynamicResource ThemeWindowBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26"
                                  ShadowDepth="7"
                                  Opacity="0.26"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="IconBadge"
                                Width="38"
                                Height="38"
                                Background="{DynamicResource ThemeAccentSubtleBrush}"
                                CornerRadius="12">
                            <TextBlock x:Name="IconGlyphText"
                                       Text="i"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TitleTextBlock"
                                   Margin="13,0,0,0"
                                   MaxWidth="350"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="×"
                            Style="{StaticResource DialogCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="HandleCloseClick" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,18,0,22"
                              MaxHeight="340"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageTextBlock"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,9,0"
                            Visibility="Collapsed"
                            Click="HandleCancelClick" />
                    <Button x:Name="PrimaryButton"
                            Content="确定"
                            Style="{StaticResource DialogPrimaryButton}"
                            IsDefault="True"
                            Click="HandlePrimaryClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
