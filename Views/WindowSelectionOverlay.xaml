<Window x:Class="ZCue.Views.WindowSelectionOverlay"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" IsHitTestVisible="False" Width="1" Height="1"
        UseLayoutRounding="True">
    <Grid>
        <Border BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="3" />
        <Canvas>
            <Border x:Name="Hint" Background="{DynamicResource ThemeWindowBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" MaxWidth="320">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="22" Margin="0,0,8,0">
                            <ui:SymbolIcon x:Name="FallbackIcon" Symbol="Window24" FontSize="22"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}" />
                            <Image x:Name="ApplicationIcon" Stretch="Uniform" />
                        </Grid>
                        <TextBlock x:Name="ProcessName" VerticalAlignment="Center" MaxWidth="255"
                                   TextTrimming="CharacterEllipsis" FontSize="13"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="松开添加 · Esc 取消" FontSize="11" Margin="0,5,0,0"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
