<ui:FluentWindow x:Class="ZCue.Views.PromptReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="插入指令引用"
        Icon="pack://application:,,,/assets/logo.png"
        Width="540" Height="520" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <!-- SECTION 指令引用选择 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="插入指令引用" ShowMinimize="False" ShowMaximize="False" />
        <Grid Grid.Row="1" Margin="24,18,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBox x:Name="SearchTextBox" Grid.Row="0" Height="40" Margin="0,0,0,12"
                        PlaceholderText="搜索名称、拼音、分类或内容" ClearButtonEnabled="True"
                        TextChanged="HandleSearchTextChanged" />
            <Grid Grid.Row="1">
                <ListBox x:Name="PromptListBox" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HandleSelectionChanged" MouseDoubleClick="HandleDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeSelectionSurfaceBrush}" />
                                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                           MaxWidth="150" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding CategoryName}" FontSize="11" Margin="12,0,0,0"
                                           MaxWidth="80" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CategoryName}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyTextBlock" Text="没有可引用的指令" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextMutedBrush}" />
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="取消" IsCancel="True" Style="{StaticResource FluentSecondaryButton}"
                           Click="HandleCancelClick" Margin="0,0,10,0" />
                <ui:Button x:Name="InsertButton" Content="插入" IsDefault="True" IsEnabled="False"
                           Style="{StaticResource FluentPrimaryButton}" Click="HandleInsertClick" />
            </StackPanel>
        </Grid>
    </Grid>
    <!-- !SECTION 指令引用选择 -->
</ui:FluentWindow>
