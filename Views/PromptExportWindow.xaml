<Window x:Class="ZCue.Views.PromptExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出提示词"
        Width="460"
        Height="520"
        MinWidth="400"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ExportCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="HoverSurface"
                                    Background="Transparent"
                                    CornerRadius="7" />
                            <Grid Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxIndicator"
                                        Width="18"
                                        Height="18"
                                        Background="{DynamicResource ThemeSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeFieldBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        VerticalAlignment="Center" />
                                <Path x:Name="CheckMark"
                                      Data="M 3,9 L 7,13 L 15,4"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                <Rectangle x:Name="IndeterminateMark"
                                           Width="9"
                                           Height="2.5"
                                           RadiusX="1.25"
                                           RadiusY="1.25"
                                           Fill="White"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="11,0,0,0" />
                            </Grid>
                            <Border x:Name="FocusRing"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="{DynamicResource ThemeHoverSurfaceBrush}" />
                                <Setter TargetName="CheckBoxIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxIndicator"
                                        Property="Background"
                                        Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="CheckBoxIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="CheckBoxIndicator"
                                        Property="Background"
                                        Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="CheckBoxIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="IndeterminateMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBoxIndicator"
                                        Property="Background"
                                        Value="{DynamicResource ThemeAccentHoverBrush}" />
                                <Setter TargetName="CheckBoxIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExportPrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExportSecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSubtleBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="选择导出分类"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontSize="22"
                       FontWeight="SemiBold" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Margin="0,18,0,16"
                Padding="12">
            <DockPanel LastChildFill="True">
                <CheckBox x:Name="SelectAllCheckBox"
                          DockPanel.Dock="Top"
                          Content="全选分类"
                          IsThreeState="True"
                          Style="{StaticResource ExportCheckBox}"
                          FontSize="15"
                          FontWeight="SemiBold"
                          Margin="2,2,2,10"
                          Checked="HandleSelectAllChanged"
                          Unchecked="HandleSelectAllChanged" />
                <Border DockPanel.Dock="Top"
                        Height="1"
                        Background="{DynamicResource ThemeBorderBrush}"
                        Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CategoryOptionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource ExportCheckBox}"
                                          FontSize="16"
                                          Margin="2,3"
                                          Padding="4,7">
                                    <Grid MinWidth="320">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PromptCount, StringFormat={}{0} 条}"
                                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,0,0" />
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource ExportSecondaryButton}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmExportButton"
                        Content="导出 JSON"
                        Style="{StaticResource ExportPrimaryButton}"
                        IsDefault="True"
                        Click="HandleConfirmExportClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
