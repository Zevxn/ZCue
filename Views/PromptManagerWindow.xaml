<ui:FluentWindow x:Class="ZCue.Views.PromptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:ZCue.Models"
        xmlns:infrastructure="clr-namespace:ZCue.Infrastructure"
        Title="ZCue"
        Icon="pack://application:,,,/assets/logo.png"
        Width="1100"
        Height="760"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="{x:Type ui:Button}">
            <Setter Property="infrastructure:ButtonPressFeedbackService.IsEnabled" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Grid>
                            <Border x:Name="NavigationSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationSurface" Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryPill" TargetType="Button">
            <Setter Property="infrastructure:ButtonPressFeedbackService.IsEnabled" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeCategoryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Cursor="{TemplateBinding Cursor}"
                              SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="16" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryContextMenuItem" TargetType="MenuItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemSurface"
                                        Property="Background"
                                        Value="{DynamicResource ThemeHoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryContextMenuDangerItem"
               TargetType="MenuItem"
               BasedOn="{StaticResource CategoryContextMenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerTextBrush}" />
        </Style>
        <Style x:Key="CategoryBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBadgeBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CategoryName}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FluentSecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDangerHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECTION 设置控件交互样式 -->
        <Style x:Key="SettingsSlider" TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutoToolTipPlacement" Value="None" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="PreviewMouseDown" Handler="HandleSettingsSliderPreviewMouseDown" />
            <EventSetter Event="PreviewGotKeyboardFocus" Handler="HandleSettingsSliderPreviewGotKeyboardFocus" />
        </Style>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Opacity" Value="0.65" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- !SECTION 设置控件交互样式 -->
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,16,8" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="HandlePromptDoubleClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.58" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowActionPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowActionIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Cursor="{TemplateBinding Cursor}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSubtleBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowDeleteIconButton"
               TargetType="Button"
               BasedOn="{StaticResource RowActionIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeDangerTextBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThemeDangerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowEnabledToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleSurface"
                                Background="Transparent"
                                CornerRadius="6"
                                Cursor="{TemplateBinding Cursor}">
                            <Grid Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Ellipse Stroke="{TemplateBinding Foreground}"
                                         StrokeThickness="1.7" />
                                <Path x:Name="ToggleMark"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 2,6 L 5,9 L 10,3"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                                <Path x:Name="ToggleOffMark"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 2,2 L 10,10"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ToggleOffMark" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeSuccessBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface"
                                        Property="Background"
                                        Value="{DynamicResource ThemeSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleSurface"
                                        Property="Background"
                                        Value="{DynamicResource ThemeAccentSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterModeRadioButton" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource DefaultRadioButtonStyle}">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <!-- SECTION Fluent 窗口与页面布局 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Height="32"
                     Title="ZCue"
                     CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/assets/logo.png"
                              Margin="0,2,-8,0" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ThemeSidebarBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="0">
                <Grid Margin="12,12,12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/assets/logo.png" Width="40" Height="40" Margin="14,0,0,0" />
                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ZCue"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Prompt 补全"
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="NavigationHost" Grid.Row="1" Margin="0,32,0,0" SizeChanged="HandleNavigationHostSizeChanged">
                        <StackPanel>
                            <TextBlock Text="工作区"
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="14,0,0,9" />
                            <ui:Button x:Name="CommandsNavigationButton"
                                    Style="{StaticResource NavigationButton}"
                                    Background="{DynamicResource ThemeAccentSurfaceBrush}"
                                    Foreground="{DynamicResource ThemeAccentTextBrush}"
                                    Click="ShowCommandsPage">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="20" Width="22" VerticalAlignment="Center" />
                                    <TextBlock Text="指令管理"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="SettingsNavigationButton"
                                    Style="{StaticResource NavigationButton}"
                                    Margin="0,4,0,0"
                                    Click="ShowSettingsPage">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="20" Width="22" VerticalAlignment="Center" />
                                    <TextBlock Text="指令设置"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="ApplicationSettingsNavigationButton"
                                    Style="{StaticResource NavigationButton}"
                                    Margin="0,4,0,0"
                                    Click="ShowApplicationSettingsPage">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="20" Width="22" VerticalAlignment="Center" />
                                    <TextBlock Text="应用设置"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                        <Border x:Name="NavigationSelectionIndicator"
                                Width="3" Height="20" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NavigationIndicatorScale" CenterY="10" />
                                    <TranslateTransform x:Name="NavigationIndicatorTranslate" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ui:Button Grid.Row="2"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,0,0,4"
                            ToolTip="在浏览器中打开 GitHub"
                            Click="HandleOpenGitHubClick">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid Width="18"
                                  Height="18"
                                  Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                <Grid.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/assets/github.png"
                                                Stretch="Uniform" />
                                </Grid.OpacityMask>
                            </Grid>
                            <TextBlock Text="GitHub"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Margin="20,12,32,24">
                <Grid x:Name="CommandsPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="指令管理"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="30"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,7,0,0">
                                <TextBlock Text="管理在任意输入框中可调用的 Prompt"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           FontSize="13" />
                                <TextBlock Text=" · "
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           FontSize="13" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=共 {0} 条}"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="HeaderActionsPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ui:Button Content="导入"
                                    Style="{StaticResource FluentSecondaryButton}"
                                    ToolTip="从 JSON 文件导入提示词"
                                    Margin="0,0,8,0"
                                    Click="HandleImportClick" />
                            <ui:Button Content="导出"
                                    Style="{StaticResource FluentSecondaryButton}"
                                    ToolTip="按分类导出提示词 JSON"
                                    Margin="0,0,8,0"
                                    Click="HandleExportClick" />
                            <ui:Button Content="新建指令" Icon="{ui:SymbolIcon Add24}"
                                    Style="{StaticResource FluentPrimaryButton}"
                                    Click="HandleAddClick" />
                        </StackPanel>
                        <Border x:Name="BatchActionsBar"
                                Background="{DynamicResource ThemeAccentSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="BatchSelectionSummary"
                                           Text="已选 0 项"
                                           Foreground="{DynamicResource ThemeAccentTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="归类到…"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Margin="0,0,7,0"
                                            Click="HandleBatchAssignCategoryClick" />
                                    <ui:Button Content="删除所选"
                                            Style="{StaticResource DangerButton}"
                                            Margin="0,0,7,0"
                                            Click="HandleBatchDeleteClick" />
                                    <ui:Button Content="清除选择"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Click="HandleClearSelectionClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CategoryPanel"
                                        Orientation="Horizontal" />
                        </ScrollViewer>
                        <ui:Button Grid.Column="1"
                                Content="＋"
                                Width="32"
                                Height="32"
                                Padding="0"
                                ToolTip="添加分类"
                                Style="{StaticResource FluentSecondaryButton}"
                                Click="HandleAddCategoryClick" />
                    </Grid>

                    <ui:TextBox x:Name="SearchTextBox" Grid.Row="2" Height="40" Margin="0,12,0,16" PlaceholderText="搜索指令名称、拼音或内容" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" VerticalContentAlignment="Center" TextChanged="HandleSearchTextChanged" />

                    <Grid Grid.Row="3">
                        <ListView x:Name="PromptListView"
                                  ItemsSource="{Binding FilteredPrompts}"
                                  SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                                  SelectionMode="Extended"
                                  SelectionChanged="HandlePromptSelectionChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  AllowDrop="True"
                                  DragOver="HandlePromptListDragOver"
                                  Drop="HandlePromptListDrop"
                                  GiveFeedback="HandleDragGiveFeedback"
                                  PreviewMouseLeftButtonDown="HandlePromptListMouseLeftButtonDown"
                                  PreviewMouseMove="HandlePromptListMouseMove"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Border x:Name="PromptRowCard"
                                                Background="{DynamicResource ThemeSurfaceBrush}"
                                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Height="56"
                                                Padding="14,9"
                                                Loaded="HandlePromptRowCardLoaded">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="170" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Preview}"
                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                           FontSize="13"
                                                           Margin="12,0,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource CategoryBadge}"
                                                        Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding CategoryName}"
                                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                               FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Grid Style="{StaticResource RowActionPanel}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Stretch"
                                              Margin="0,1,1,1">
                                            <Border x:Name="RowActionSurface"
                                                    Background="{DynamicResource ThemeSurfaceBrush}"
                                                    CornerRadius="0,9,9,0">
                                                <Border.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#FF000000" Offset="0.18" />
                                                        <GradientStop Color="#FF000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.OpacityMask>
                                            </Border>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="28,0,8,0"
                                                        Panel.ZIndex="1">
                                                <TextBlock x:Name="UsageCountText"
                                                           Text="{Binding UsageCount, StringFormat=使用 {0} 次}"
                                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Style="{StaticResource RowEnabledToggle}"
                                                          Click="HandleEnabledClick"
                                                          ToolTip="启用/禁用"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,2,0" />
                                                <ui:Button Tag="{Binding}"
                                                        Style="{StaticResource RowActionIconButton}"
                                                        ToolTip="复制内容"
                                                        Click="HandleCopyClick"
                                                        Margin="2,0,0,0">
                                                    <Grid Width="16" Height="16">
                                                        <Path Width="16"
                                                              Height="16"
                                                              Stretch="Uniform"
                                                              Data="M 8,8 H 20 V 21 H 8 Z M 4,16 V 4 H 16 V 8"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                        <Path Width="16"
                                                              Height="16"
                                                              Stretch="Uniform"
                                                              Data="M 2,8 L 6,12 L 14,4"
                                                              Fill="Transparent"
                                                              Stroke="{DynamicResource ThemeSuccessBrush}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Visibility="Collapsed" />
                                                    </Grid>
                                                </ui:Button>
                                                <ui:Button Tag="{Binding}"
                                                        Style="{StaticResource RowActionIconButton}"
                                                        ToolTip="编辑"
                                                        Click="HandleEditClick"
                                                        Margin="2,0,0,0">
                                                    <Path Width="16"
                                                          Height="16"
                                                          Stretch="Uniform"
                                                          Data="M 11,4 H 4 V 20 H 20 V 13 M 18,2 L 22,6 L 12,16 L 8,17 L 9,13 Z"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </ui:Button>
                                                <ui:Button Tag="{Binding}"
                                                        Style="{StaticResource RowDeleteIconButton}"
                                                        ToolTip="删除"
                                                        Click="HandleDeleteClick"
                                                        Margin="2,0,0,0">
                                                    <Path Width="16"
                                                          Height="16"
                                                          Stretch="Uniform"
                                                          Data="M 4,6 H 20 M 9,6 V 4 H 15 V 6 M 6,6 L 7,20 H 17 L 18,6 M 10,10 V 16 M 14,10 V 16"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                        <Border x:Name="PromptRowSelectionBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="10"
                                                IsHitTestVisible="False"
                                                Panel.ZIndex="2"
                                                Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                     Value="True">
                                            <Setter TargetName="PromptRowCard"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource ThemeAccentSoftBrush}" />
                                            <Setter TargetName="UsageCountText"
                                                    Property="Foreground"
                                                    Value="{DynamicResource ThemeAccentSoftBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                     Value="True">
                                            <Setter TargetName="PromptRowCard"
                                                    Property="Background"
                                                    Value="{DynamicResource ThemeSelectionSurfaceBrush}" />
                                            <Setter TargetName="RowActionSurface"
                                                    Property="Background"
                                                    Value="{DynamicResource ThemeSelectionSurfaceBrush}" />
                                            <Setter TargetName="PromptRowCard"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource ThemeBorderBrush}" />
                                            <Setter TargetName="PromptRowCard"
                                                    Property="BorderThickness"
                                                    Value="1" />
                                            <Setter TargetName="PromptRowSelectionBorder"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource ThemeAccentSoftBrush}" />
                                            <Setter TargetName="PromptRowSelectionBorder"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border x:Name="EmptyState"
                                Visibility="Collapsed"
                                Background="{DynamicResource ThemeSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="30"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="没有找到匹配的指令"
                                           Foreground="{DynamicResource ThemeTextStrongBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="尝试搜索其他关键词，或新建一条指令"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           FontSize="13"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="SettingsPage"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="指令设置"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="调整 ZCue 的输入监听和候选交互方式"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,7,0,0" />
                    </StackPanel>

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,26,0,0"
                                  Padding="0,0,14,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="输入与候选"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,9" />

                                <StackPanel>
                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="全局输入监听" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="关闭后暂停在所有应用中的 Prompt 补全" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:ToggleSwitch x:Name="ListeningCheckBox" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding IsListeningEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" />
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="显示内容预览" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="在当前输入框内实时预览选中指令对应内容" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:ToggleSwitch x:Name="PreviewCheckBox" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding ShowContentPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" />
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="中文选词期间显示候选" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="输入拼音或选词时显示 ZCue 候选，按 ↑/↓ 切换、Tab 插入；数字、空格等仍用于选词" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding ShowSuggestionsDuringImeComposition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" />
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="NumberSymbol24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="数字键选择候选" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="使用 1～9 直接确认对应的候选项" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:ToggleSwitch x:Name="NumberSelectionCheckBox" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableNumberSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" />
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="ArrowEnterLeft24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="Enter 确认候选" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="候选框打开时按 Enter 插入当前选中的 Prompt" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:ToggleSwitch x:Name="EnterConfirmationCheckBox" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableEnterConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" />
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="启用拼音匹配" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="允许使用 Prompt 名称的全拼或首字母进行匹配" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnablePinyinWake, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" />
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="TextFont24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="中文触发阈值" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="汉字输入字数达到该阈值后才参与匹配" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,3,0">
                                                <TextBlock Text="{Binding CnWakeThreshold}" Width="24" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Slider Width="150" Style="{StaticResource SettingsSlider}" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CnWakeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="TextFont24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="拼音触发阈值" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="拼音或首字母输入达到该阈值后才参与匹配" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,3,0">
                                                <TextBlock Text="{Binding PinWakeThreshold}" Width="24" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Slider Width="150" Style="{StaticResource SettingsSlider}" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PinWakeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Options24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="英文触发阈值" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="非汉字输入达到该阈值后才参与匹配" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,3,0">
                                                <TextBlock Text="{Binding EnWakeThreshold}" Width="24" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Slider Width="150" Style="{StaticResource SettingsSlider}" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding EnWakeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Style="{StaticResource FluentSettingCard}">
                                        <Grid MinHeight="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Resize24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="候选框宽度" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                    <TextBlock TextWrapping="Wrap" Text="调整全局候选窗口宽度（200–1000）" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,3,0">
                                                <TextBlock Text="{Binding SuggestionBoxWidth}" Width="40" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Slider Width="150" Style="{StaticResource SettingsSlider}" Minimum="200" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding SuggestionBoxWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </StackPanel>

                            <TextBlock Text="应用范围"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="2,24,0,9" />
                            <Border Background="{DynamicResource ThemeSurfaceBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="18,12">
                                <StackPanel>
                                    <TextBlock Text="工作模式"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,7" />
                                    <RadioButton Content="黑名单模式"
                                                 Style="{StaticResource FilterModeRadioButton}"
                                                 GroupName="ApplicationFilterMode"
                                                 IsChecked="{Binding IsBlacklistMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                 FontSize="13" />
                                    <TextBlock Text="默认在所有应用中启用，名单中的应用除外"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="22,3,0,10" />
                                    <Border Height="1" Background="{DynamicResource ThemeDividerBrush}" />
                                    <RadioButton Content="白名单模式"
                                                 Style="{StaticResource FilterModeRadioButton}"
                                                 GroupName="ApplicationFilterMode"
                                                 IsChecked="{Binding IsWhitelistMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                 FontSize="13"
                                                 Margin="0,10,0,0" />
                                    <TextBlock Text="默认在所有应用中禁用，仅名单中的应用会启用"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="22,3,0,14" />
                                    <Border Height="1" Background="{DynamicResource ThemeDividerBrush}" />
                                    <TextBlock Text="{Binding CurrentApplicationListTitle}"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,14,0,9" />
                                    <Border Background="{DynamicResource ThemeWindowBackgroundBrush}"
                                            BorderBrush="{DynamicResource ThemeDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="10,6,0,6">
                                        <ScrollViewer MaxHeight="160"
                                                      Padding="0,0,12,0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="HandleApplicationListPreviewMouseWheel">
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentApplicationNames.Count}" Value="0">
                                                                <Setter Property="MinHeight" Value="64" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ItemsControl ItemsSource="{Binding CurrentApplicationNames}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <ui:Button Grid.Column="1"
                                                                        Tag="{Binding}"
                                                                        Content="删除"
                                                                        Style="{StaticResource DangerButton}"
                                                                        FontSize="12"
                                                                        Padding="9,5"
                                                                        Margin="8,0,0,0"
                                                                        Click="RemoveApplicationClick" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="当前名单为空"
                                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentApplicationNames.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,12,0,2">
                                        <ui:Button Content="添加当前应用"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Click="AddCurrentApplicationClick"
                                                Margin="0,0,8,0" />
                                        <ui:Button Content="选择程序"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Click="SelectApplicationClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Prompt 会立即保存到指定数据位置，交互设置保存在本机配置目录；监听开关仅对本次运行生效"
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       FontSize="12"
                                       Margin="2,18,0,14" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ApplicationSettingsPage"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="应用设置"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="调整 ZCue 的外观、数据位置、系统启动和应用信息"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,7,0,0" />
                    </StackPanel>

                    <ScrollViewer x:Name="ApplicationSettingsScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,26,0,0"
                                  Padding="0,0,14,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="外观"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,9" />

                                <ui:Card Style="{StaticResource FluentSettingCard}">
                                    <Grid MinHeight="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,24,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="PaintBrush24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock TextWrapping="Wrap" Text="界面主题" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                <TextBlock TextWrapping="Wrap" Text="选择浅色、深色，或跟随 Windows 外观" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox Grid.Column="1" Width="120" Height="36" Padding="12,5,8,5" VerticalContentAlignment="Center" Style="{StaticResource FieldComboBox}" ItemContainerStyle="{StaticResource ThemeComboBoxItem}" SelectedValuePath="Tag" SelectedValue="{Binding ThemeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" PreviewMouseWheel="HandleThemeModePreviewMouseWheel">
                                            <ComboBoxItem Content="跟随系统" Tag="{x:Static models:AppThemeMode.System}" />
                                            <ComboBoxItem Content="浅色模式" Tag="{x:Static models:AppThemeMode.Light}" />
                                            <ComboBoxItem Content="深色模式" Tag="{x:Static models:AppThemeMode.Dark}" />
                                        </ComboBox>
                                    </Grid>
                                </ui:Card>

                            <TextBlock Text="系统"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="2,24,0,9" />

                                <ui:Card Style="{StaticResource FluentSettingCard}">
                                    <Grid MinHeight="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,24,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Power24" FontSize="22" Width="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock TextWrapping="Wrap" Text="开机启动" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" FontWeight="Normal" />
                                                <TextBlock TextWrapping="Wrap" Text="登录 Windows 后自动启动 ZCue" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <ui:ToggleSwitch x:Name="StartupCheckBox" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="24,0,3,0" />
                                    </Grid>
                                </ui:Card>

                            <!-- SECTION 提示词数据位置设置 -->
                            <TextBlock Text="数据"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="2,24,0,9" />
                            <ui:Card Style="{StaticResource FluentSettingCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                            <TextBlock Text="提示词数据位置"
                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                       FontSize="14" />
                                            <TextBlock Text="目标文件已存在时使用其中的提示词和分类，不存在时复制当前数据；原文件保留"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1"
                                                   Content="更改位置"
                                                   Style="{StaticResource FluentSecondaryButton}"
                                                   VerticalAlignment="Center"
                                                   Click="HandleChangePromptDataLocationClick" />
                                    </Grid>
                                    <TextBox Text="{Binding PromptDataFilePath, Mode=OneWay}"
                                             ToolTip="{Binding PromptDataFilePath}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Style="{StaticResource RoundedTextBoxBase}"
                                             Margin="0,12,0,0" />
                                </StackPanel>
                            </ui:Card>
                            <!-- !SECTION 提示词数据位置设置 -->

                            <TextBlock Text="关于"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="2,24,0,9" />
                            <Border Background="{DynamicResource ThemeSurfaceBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="18,14"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ZCue"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="VersionTextBlock"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ui:Button x:Name="CheckUpdatesButton"
                                                Content="检查更新"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Padding="12,8"
                                                Margin="0,0,8,0"
                                                ToolTip="检查 GitHub 上是否有新版本"
                                                Click="HandleCheckUpdatesClick" />
                                        <ui:Button Content="查看 GitHub Releases"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Padding="12,8"
                                                ToolTip="在浏览器中打开 ZCue Releases 页面"
                                                Click="HandleOpenReleasesClick" />
                                    </StackPanel>
                                    <Border Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,14,0,0"
                                            Padding="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="自动通知更新"
                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="应用启动时自动检查，发现新版本时通过系统托盘通知"
                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1"
                                                      Style="{StaticResource FluentToggleSwitch}"
                                                      IsChecked="{Binding EnableAutomaticUpdateNotifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      Margin="24,0,3,0" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Canvas x:Name="DragPreviewCanvas"
                    Panel.ZIndex="1000"
                    IsHitTestVisible="False"
                    ClipToBounds="False" />
        </Grid>
    </Grid>
    <!-- !SECTION Fluent 窗口与页面布局 -->
</ui:FluentWindow>
