<Window x:Class="TypeSense.Views.PromptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeSense"
        Icon="pack://application:,,,/assets/logo.png"
        Width="980"
        Height="660"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryPill" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryBadge" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CategoryName}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#DC2626" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchTrack"
                                Background="#CBD5E1"
                                CornerRadius="13"
                                Padding="3">
                            <Ellipse x:Name="SwitchThumb"
                                     Width="20"
                                     Height="20"
                                     Fill="White"
                                     HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Background"
                                        Value="#2563EB" />
                                <Setter TargetName="SwitchThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="Opacity"
                                        Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack"
                                        Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Focusable" Value="True" />
            <EventSetter Event="MouseDoubleClick" Handler="HandlePromptDoubleClick" />
        </Style>
        <Style x:Key="RowActionPanel" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#2563EB">
                        <TextBlock Text="TS"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="TypeSense"
                                   Foreground="#0F172A"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Prompt 补全"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,42,0,0">
                    <TextBlock Text="工作区"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="14,0,0,9" />
                    <Button x:Name="CommandsNavigationButton"
                            Content="▦   指令管理"
                            Style="{StaticResource NavigationButton}"
                            Background="#DBEAFE"
                            Foreground="#1D4ED8"
                            Click="ShowCommandsPage" />
                    <Button x:Name="SettingsNavigationButton"
                            Content="⚙   软件设置"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,4,0,0"
                            Click="ShowSettingsPage" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="#E2E8F0"
                        CornerRadius="9"
                        Padding="12"
                        Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="本地数据"
                                   Foreground="#334155"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                        <TextBlock Text="指令保存在当前用户的本机配置目录。"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="34,28,34,24">
            <Grid x:Name="CommandsPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="指令管理"
                                   Foreground="#0F172A"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,7,0,0">
                            <TextBlock Text="管理在任意输入框中可调用的 Prompt"
                                       Foreground="#64748B"
                                       FontSize="13" />
                            <TextBlock Text=" · "
                                       Foreground="#CBD5E1"
                                       FontSize="13" />
                            <TextBlock Text="{Binding TotalCount, StringFormat=共 {0} 条}"
                                       Foreground="#64748B"
                                       FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="＋  新增指令"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="HandleAddClick" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryPanel"
                                    Orientation="Horizontal" />
                    </ScrollViewer>
                    <Button Grid.Column="1"
                            Content="＋"
                            Width="32"
                            Height="32"
                            Padding="0"
                            ToolTip="添加分类"
                            Style="{StaticResource SecondaryButton}"
                            Click="HandleAddCategoryClick" />
                </Grid>

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,12,0,16"
                        Padding="12,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="⌕"
                                   Foreground="#94A3B8"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,2" />
                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource FieldTextBox}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 ToolTip="搜索指令名称、缩写或内容"
                                 TextChanged="HandleSearchTextChanged" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="3">
                    <ListView x:Name="PromptListView"
                              ItemsSource="{Binding FilteredPrompts}"
                              SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              AllowDrop="True"
                              DragOver="HandlePromptListDragOver"
                              Drop="HandlePromptListDrop"
                              GiveFeedback="HandleDragGiveFeedback"
                              PreviewMouseLeftButtonDown="HandlePromptListMouseLeftButtonDown"
                              PreviewMouseMove="HandlePromptListMouseMove"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Height="56"
                                        Padding="14,9">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="⋮⋮"
                                                   Tag="PromptDragHandle"
                                                   Cursor="SizeAll"
                                                   Foreground="#CBD5E1"
                                                   FontSize="17"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Foreground="#0F172A"
                                                   FontSize="15"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="170" />
                                        <Border Grid.Column="2"
                                                Style="{StaticResource CategoryBadge}"
                                                Margin="11,0,0,0">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       Foreground="#64748B"
                                                       FontSize="11" />
                                        </Border>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Preview}"
                                                   Foreground="#64748B"
                                                   FontSize="13"
                                                   Margin="12,0,14,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4"
                                                    Style="{StaticResource RowActionPanel}"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0">
                                            <TextBlock Text="{Binding UsageCount, StringFormat=使用 {0} 次}"
                                                       Foreground="#94A3B8"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,14,0" />
                                            <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Click="HandleEnabledClick"
                                                      ToolTip="启用/禁用"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,14,0" />
                                            <Button Content="编辑"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="HandleEditClick" />
                                            <Button Content="删除"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Margin="7,0,0,0"
                                                    Click="HandleDeleteClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border x:Name="EmptyState"
                            Visibility="Collapsed"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="30"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="没有找到匹配的指令"
                                       Foreground="#334155"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="尝试搜索其他关键词，或新建一条指令。"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       Margin="0,7,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPage"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="软件设置"
                               Foreground="#0F172A"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Text="调整 TypeSense 的输入监听和候选交互方式"
                               Foreground="#64748B"
                               FontSize="13"
                               Margin="0,7,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,26,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="输入与候选"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="2,0,0,9" />
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,4">
                            <StackPanel>
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="全局输入监听"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="关闭后暂停在所有应用中的 Prompt 补全。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ListeningCheckBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsListeningEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               VerticalAlignment="Center"
                                               Margin="24,0,3,0" />
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="输入框内幽灵文字"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="在当前光标后显示选中 Prompt 的灰色预览。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="GhostPreviewCheckBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding ShowGhostPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="24,0,3,0" />
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="显示内容预览"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="在候选名称右侧显示 Prompt 内容摘要。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="PreviewCheckBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding ShowContentPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="24,0,3,0" />
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="数字键选择候选"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="使用 1～9 直接确认对应的候选项。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="NumberSelectionCheckBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding EnableNumberSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="24,0,3,0" />
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Enter 确认候选"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="候选框打开时按 Enter 插入当前选中的 Prompt。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="EnterConfirmationCheckBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding EnableEnterConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="24,0,3,0" />
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="启用拼音匹配"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="允许使用 Prompt 名称的全拼或首字母进行匹配。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding EnablePinyinWake, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="24,0,3,0" />
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="中文触发阈值"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="控制汉字输入的唤醒长度，以及拼音匹配至少覆盖的汉字数。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,3,0">
                                        <TextBlock Text="{Binding CnWakeThreshold}"
                                                   Width="24"
                                                   Foreground="#64748B"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Slider Width="150"
                                                Minimum="1"
                                                Maximum="5"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding CnWakeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="拼音触发阈值"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="拼音或首字母输入达到该长度后才参与匹配。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,3,0">
                                        <TextBlock Text="{Binding PinWakeThreshold}"
                                                   Width="24"
                                                   Foreground="#64748B"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Slider Width="150"
                                                Minimum="1"
                                                Maximum="5"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding PinWakeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="英文触发阈值"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="非汉字输入达到该长度后开始搜索，避免单个字符触发。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,3,0">
                                        <TextBlock Text="{Binding EnWakeThreshold}"
                                                   Width="24"
                                                   Foreground="#64748B"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Slider Width="150"
                                                Minimum="1"
                                                Maximum="5"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding EnWakeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#F1F5F9" />
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="候选框宽度"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="调整全局候选窗口宽度（200–1000）。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,3,0">
                                        <TextBlock Text="{Binding SuggestionBoxWidth}"
                                                   Width="40"
                                                   Foreground="#64748B"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Slider Width="150"
                                                Minimum="200"
                                                Maximum="1000"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding SuggestionBoxWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="系统"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="2,24,0,9" />
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,4">
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开机启动"
                                               Foreground="#0F172A"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="登录 Windows 后自动启动 TypeSense。"
                                               Foreground="#64748B"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="StartupCheckBox"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding LaunchAtStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center"
                                          Margin="24,0,3,0" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Prompt 和交互设置会立即保存到本机配置目录；监听开关仅对本次运行生效。"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="2,18,0,20" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Canvas x:Name="DragPreviewCanvas"
                Panel.ZIndex="1000"
                IsHitTestVisible="False"
                ClipToBounds="False" />
    </Grid>
</Window>
